<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand in for an EVE Online client, for testing EVE-O Cycle without logging
    six accounts in. The assembly name matters: EVE runs as ExeFile.exe, and that
    is the process name EVE-O Cycle looks for by default.

    Run it with the window title to pretend to be:
      ExeFile.exe "EVE - Main Toon"
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ExeFile</AssemblyName>
    <RootNamespace>EveOMock</RootNamespace>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
