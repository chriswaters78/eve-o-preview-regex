<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>EVE-O Cycle</AssemblyName>
    <RootNamespace>EveOCycle</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Required by the LibraryImport source generator, which marshals through pointers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>EVE-O Cycle</Product>
    <Description>Hotkey driven client switcher for EVE Online</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Written out next to the executable when no configuration file is found -->
    <EmbeddedResource Include="EVE-O Cycle.sample.json" LogicalName="EveOCycle.SampleConfiguration.json" />
  </ItemGroup>

</Project>
